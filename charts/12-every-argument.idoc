@section(Fits and models)

trend=poly:2 fits that curve to the points.

@graph(type=scatter, x=x, y=y, trend=poly:2)
@data
x,y
1,2.1
2,4.3
3,8.8
4,16.5
5,31.0
6,63.2
@end

trend=poly:3 fits that curve to the points.

@graph(type=scatter, x=x, y=y, trend=poly:3)
@data
x,y
1,2.1
2,4.3
3,8.8
