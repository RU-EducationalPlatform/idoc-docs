@section(Axes, sizes and type)

xlabel= and ylabel= title the axes; xmin=, xmax=, ymin= and ymax= set the scale; height= sets the drawing height.

@graph(type=line, x=week, y=Lab, xlabel="Week", ylabel="Mark", xmin=0, xmax=6, ymin=0, ymax=100, height=240)
@data
week,Lab,Quiz
1,62,55
2,68,60
3,71,66
4,75,64
5,80,72
@end

log=y draws the y axis on a log scale.

@graph(type=scatter, x=x, y=y, log=y)
@data
x,y
1,2.1
2,4.3
3,8.8
4,16.5
5,31.0
6,63.2
@end

fontsize=large scales all the chart text.

@graph(type=bar, x=team, y=Spring, title="Spring", fontsize=large)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

fontsize=huge scales all the chart text.

@graph(type=bar, x=team, y=Spring, title="Spring", fontsize=huge)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

fontsize=small scales all the chart text.

@graph(type=bar, x=team, y=Spring, title="Spring", fontsize=small)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

fontsize=18 scales all the chart text.

@graph(type=bar, x=team, y=Spring, title="Spring", fontsize=18)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

fontsize=1.4 scales all the chart text.

@graph(type=bar, x=team, y=Spring, title="Spring", fontsize=1.4)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

ticksize=, labelsize=, titlesize= and legendsize= size each kind of text on its own.

@graph(type=line, x=week, y=Lab;Quiz, title="Marks", xlabel="Week", ylabel="Mark", ticksize=small, labelsize=large, titlesize=1.5, legendsize=1.4)
@data
week,Lab,Quiz
1,62,55
2,68,60
3,71,66
4,75,64
5,80,72
@end

benchmark= names a value that receives the chart's drawing time in ms.

@graph(type=bar, x=team, y=Spring, benchmark=bartime)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

@section(Networks, slopes and bullets)

from= and to= name the two columns of a slopegraph.

@graph(type=slopegraph, label=club, from=y2019, to=y2024)
@data
club,y2019,y2024
Chess,30,42
Robotics,55,48
Drama,20,35
@end

from= and to= also name a network's source and target columns.

@graph(type=network, from=a, to=b)
@data
a,b
Sensors,Signals
Signals,Control
Control,Motors
@end

dict draws the equation dictionaries as a network; cats= keeps only the ones listed.

@graph(type=network, dict, cats=fd;ee)

target= names a bullet chart's target column.

@graph(type=bullet, label=metric, value=actual, target=goal)
@data
metric,actual,goal
Labs done,8,10
Quizzes,5,6
@end

