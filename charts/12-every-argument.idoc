@section(3-D and terrain)

view=front starts a model facing the viewer; spin=on turns it slowly until touched.

@graph(type=mesh, src=torus.cmesh, view=front, spin=on)

shade=flat on a 3-D mesh.

@graph(type=mesh, src=torus.cmesh, shade=flat)

shade=wire on a 3-D mesh.

@graph(type=mesh, src=torus.cmesh, shade=wire)

weather= drapes readings over time on terrain; sky=none lets the page show behind it; frame=none drops the card border.

@graph(type=terrain, weather=weather.csv, sky=none, frame=none)
