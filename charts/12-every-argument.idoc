@section(Summarising the data)

normalize=percent rescales each series.

@graph(type=bar, x=team, y=Spring;Fall, normalize=percent)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

normalize=max rescales each series.

@graph(type=bar, x=team, y=Spring;Fall, normalize=max)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

normalize=zscore rescales each series.

@graph(type=bar, x=team, y=Spring;Fall, normalize=zscore)
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

agg=sum combines rows that share a category.

@graph(type=bar, x=section, y=score, agg=sum)
@data
section,score
A,70
A,80
B,65
B,90
B,75
C,85
@end

agg=mean combines rows that share a category.

@graph(type=bar, x=section, y=score, agg=mean)
@data
section,score
A,70
A,80
B,65
B,90
B,75
C,85
@end

agg=count combines rows that share a category.

@graph(type=bar, x=section, y=score, agg=count)
@data
section,score
A,70
A,80
B,65
B,90
B,75
C,85
@end

agg=min combines rows that share a category.

@graph(type=bar, x=section, y=score, agg=min)
@data
section,score
