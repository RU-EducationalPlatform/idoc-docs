@style(IDocDemo)
@title(Charts: Every argument)

Every @@graph argument and allowed value that the other chart files do not already use, each in one small working chart with invented data.

@section(Alias chart types)

type=grouped_bar is the same as bar with several series.

@graph(type=grouped_bar, x=team, y=Spring;Fall, title="Points by term")
@data
team,Spring,Fall
Red,40,55
Blue,25,30
Green,35,20
@end

type=parcoords is the same as parallel.

@graph(type=parcoords, title="Three measures")
@data
name,speed,mass,cost
A,3,7,2
B,5,4,6
C,8,2,4
@end

type=function is the same as surface: a function of x and y, no data needed.

@graph(type=function, z=x*y, x=-2:2, y=-2:2)

type=surf3d is another name for the same surface.

@graph(type=surf3d, z=x^2 + y^2, x=-2:2, y=-2:2)

type=scene is the same as choropleth; geo=world shades countries.

@graph(type=scene, geo=world, region=country, value=value, title="Invented values by country")
@data
country,value
Brazil,40
India,70
Canada,25
Kenya,55
France,35
@end

type=worldmap is the same as globe.

@graph(type=worldmap)

type=gapminder is the same as bubble: time= animates it, trails= draws a fading trail, glow=on lights the bubbles, board= adds a leaderboard, unit= suffixes y, labels=all names every bubble.

@graph(type=gapminder, x=income, y=life, size=pop, label=country, time=year, trails=3, glow=on, board=2, unit=%, labels=all)
@data
country,year,income,life,pop
Alba,2000,10,60,5
Alba,2010,14,66,6
Alba,2020,18,71,7
Borvia,2000,4,50,20
Borvia,2010,7,58,24
Borvia,2020,11,64,28
Celsa,2000,25,74,3
Celsa,2010,28,77,3
Celsa,2020,31,79,4
@end

timeformat=clock shows an hour value as 10:15 on a bubble chart's clock.

@graph(type=bubble, x=a, y=b, size=n, label=who, time=hour, timeformat=clock)
@data
who,hour,a,b,n
P,9.25,1,2,3
P,10.5,2,3,3
Q,9.25,3,1,2
Q,10.5,4,2,2
@end

@section(Function plots)

r= names an intermediate expression the z= formula can use; res= sets the samples per axis.

@graph(z=sin(r)/r, r=sqrt(x^2+y^2), x=-8:8, y=-8:8, res=64)

view=heatmap draws the function this way.

@graph(z=x^2 - y^2, x=-3:3, y=-3:3, view=heatmap)

view=surface draws the function this way.

@graph(z=x^2 - y^2, x=-3:3, y=-3:3, view=surface)

view=heatmap+contour draws the function this way.

@graph(z=x^2 - y^2, x=-3:3, y=-3:3, view=heatmap+contour)

color=roygbv colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=roygbv)

color=rainbow colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=rainbow)

color=jet colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=jet)

color=turbo colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=turbo)

color=viridis colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=viridis)

color=plasma colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=plasma)

color=inferno colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=inferno)

color=magma colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=magma)

color=greys colours the surface with that scale.

@graph(z=sin(x)*cos(y), x=-3:3, y=-3:3, view=heatmap, color=greys)

