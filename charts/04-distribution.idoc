@row
@cell
@b{Strip}

Every observation as a point — honest about small samples.

@graph(type=strip, x=section, y=score, title="Every score, one dot each")
@data
section,score
Morning,71
Morning,78
Morning,64
Morning,83
Evening,88
Evening,91
Evening,84
@end

